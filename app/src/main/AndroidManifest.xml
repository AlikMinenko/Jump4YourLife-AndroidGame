<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.jump4yourlife">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/jumpgamelogo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/jumpgamelogo_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".RulesActivity" android:label="Rules"/>
        <activity android:name=".LeaderBoardActivity" android:label="LeaderBoard" />

        <receiver
            android:name=".BluetootheReciver"
            android:enabled="true"
            android:exported="true" />

        <activity android:name=".GameActivity" />
        <activity android:name=".game" />
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".NotificationService" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>